COMPOSE_PROFILES=dev
DATABASE_URL=jdbc:postgresql://localhost:5432/hilflingdb
# RSA keypair for signing/verifying JWTs (RS256). Generate with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out priv.pem
#   openssl rsa -in priv.pem -pubout -out pub.pem
# Then convert each PEM to a single base64 line (strip the -----BEGIN/END----- lines):
#   echo "JWT_PRIVATE_KEY=$(grep -v 'KEY-----' priv.pem | tr -d '\n')"
#   echo "JWT_PUBLIC_KEY=$(grep -v 'KEY-----' pub.pem | tr -d '\n')"
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Public Azure hostname that resolves DIRECTLY to this box's public IP
# (e.g. arim-fg.norwaycentral.cloudapp.azure.com). Samfundet's upstream Apache
# proxies /api to https://<this host>, so Traefik must serve a Let's Encrypt cert
# for it. HTTP-01 validation reaches Traefik directly because this DNS bypasses
# the Samfundet reverse proxy.
AZURE_PUBLIC_HOSTNAME=